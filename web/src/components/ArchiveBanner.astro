---
export interface Props {
  lang?: 'zh' | 'en';
}
const { lang = 'en' } = Astro.props;
---

<div class="mb-8 rounded-lg border border-amber-200 bg-amber-50 p-4">
  <div class="flex items-start gap-3">
    <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
    <div>
      <p class="text-sm font-medium text-amber-800">
        {lang === 'zh'
          ? '本文已归档。TinyOpt 是一款面向电商卖家的图片批量处理工具。'
          : 'This article has been archived. TinyOpt is a batch image processing tool for e-commerce sellers.'}
      </p>
      <p class="mt-1 text-sm text-amber-700">
        {lang === 'zh' ? (
          <>查看我们的 <a href="/zh/blog/" class="font-medium underline hover:text-amber-900">电商图片优化专题</a></>
        ) : (
          <>See our <a href="/blog/" class="font-medium underline hover:text-amber-900">e-commerce image optimization guides</a></>
        )}
      </p>
    </div>
  </div>
</div>
