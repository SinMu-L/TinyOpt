---
import { translation } from '@/i18n/utils';
import MobileMenu from './MobileMenu.tsx';

export interface Props {
  lang: 'zh' | 'en';
  langHref?: string;
}

const { lang, langHref: overrideLangHref } = Astro.props;
const _ = translation(lang);
const pathname = Astro.url.pathname;

function isActive(path: string): boolean {
  if (path === '/') return pathname === '/' || pathname === '/zh/';
  return pathname.startsWith(path);
}

const navItems = [
  { label: _.nav.home, href: lang === 'en' ? '/' : '/zh/', active: isActive('/') && (pathname === '/' || pathname === '/zh/') },
  { label: _.nav.about, href: lang === 'en' ? '/about/' : '/zh/about/', active: isActive('/about') },
  { label: _.nav.download, href: lang === 'en' ? '/download/' : '/zh/download/', active: isActive('/download') },
  { label: _.nav.cases, href: lang === 'en' ? '/cases/' : '/zh/cases/', active: isActive('/cases') },
  { label: _.nav.blog, href: lang === 'en' ? '/blog/' : '/zh/blog/', active: isActive('/blog') },
  { label: _.nav.contact, href: lang === 'en' ? '/contact/' : '/zh/contact/', active: isActive('/contact') },
  { label: _.nav.tools, href: lang === 'en' ? '/tools/compress/' : '/zh/tools/compress/', active: isActive('/tools') },
  { label: _.nav.terms_short, href: lang === 'en' ? '/terms/' : '/zh/terms/', active: isActive('/terms') },
];
const fallbackLangHref = lang === 'en'
  ? '/zh' + (pathname === '/' ? '' : pathname)
  : pathname.replace(/^\/zh/, '') || '/';
const langHref = overrideLangHref ?? fallbackLangHref;
const langLabel = lang === 'en' ? '中文' : 'EN';
---

  <header class="sticky top-0 z-50 border-b border-gray-100 bg-white lg:bg-white/80 lg:backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href={lang === 'en' ? '/' : '/zh/'} class="flex items-center gap-2 text-lg font-bold text-primary-600 hover:text-primary-700">
      <img src="/images/logo.svg" alt="TinyOpt" class="h-8 w-8" />
      {_.brand}
    </a>

    <div class="hidden lg:flex lg:items-center lg:gap-6 text-sm font-medium text-gray-600">
      <a href={lang === 'en' ? '/' : '/zh/'} class={`hover:text-primary-600 transition-colors ${isActive('/') && (pathname === '/' || pathname === '/zh/') ? 'text-primary-600' : ''}`}>
        {_.nav.home}
      </a>
      <a href={lang === 'en' ? '/about/' : '/zh/about/'} class={`hover:text-primary-600 transition-colors ${isActive('/about') ? 'text-primary-600' : ''}`}>
        {_.nav.about}
      </a>
      <a href={lang === 'en' ? '/download/' : '/zh/download/'} class={`hover:text-primary-600 transition-colors ${isActive('/download') ? 'text-primary-600' : ''}`}>
        {_.nav.download}
      </a>
      <a href={lang === 'en' ? '/cases/' : '/zh/cases/'} class={`hover:text-primary-600 transition-colors ${isActive('/cases') ? 'text-primary-600' : ''}`}>
        {_.nav.cases}
      </a>
      <a href={lang === 'en' ? '/blog/' : '/zh/blog/'} class={`hover:text-primary-600 transition-colors ${isActive('/blog') ? 'text-primary-600' : ''}`}>
        {_.nav.blog}
      </a>
      <a href={lang === 'en' ? '/contact/' : '/zh/contact/'} class={`hover:text-primary-600 transition-colors ${isActive('/contact') ? 'text-primary-600' : ''}`}>
        {_.nav.contact}
      </a>
      <a href={lang === 'en' ? '/tools/compress/' : '/zh/tools/compress/'} class={`hover:text-primary-600 transition-colors ${isActive('/tools') ? 'text-primary-600' : ''}`}>
        {_.nav.tools}
      </a>
      <a href={lang === 'en' ? '/terms/' : '/zh/terms/'} class={`hover:text-primary-600 transition-colors ${isActive('/terms') ? 'text-primary-600' : ''}`}>
        {_.nav.terms_short}
      </a>

      <a href={langHref} class="ml-2 rounded-full border border-gray-300 px-3 py-1 text-xs hover:bg-gray-50 transition-colors">
        {langLabel}
      </a>
    </div>

    <MobileMenu
      client:load
      navItems={navItems}
      langHref={langHref}
      langLabel={langLabel}
      menuLabel={_.nav.menu}
    />
  </nav>
</header>
