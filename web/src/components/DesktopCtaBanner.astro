---
import { translation } from '@/i18n/utils';

export interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const _ = translation(lang);
const tc = _.tools.cta;
const downloadHref = lang === 'en' ? '/download/' : '/zh/download/';
---

<section class="bg-gradient-to-r from-primary-600 to-primary-700 py-14">
  <div class="mx-auto max-w-6xl px-4">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">{tc.title}</h2>
      <p class="text-primary-100 max-w-xl mx-auto">{tc.subtitle}</p>
    </div>

    <div class="overflow-x-auto mb-8">
      <table class="w-full max-w-3xl mx-auto text-sm border-collapse">
        <thead>
          <tr class="border-b border-primary-400/40">
            <th class="px-4 py-3 text-left font-semibold text-white/90">{lang === 'en' ? 'Feature' : '功能'}</th>
            <th class="px-4 py-3 text-left font-semibold text-primary-100">{lang === 'en' ? 'Online Tool' : '在线工具'}</th>
            <th class="px-4 py-3 text-left font-semibold text-white">TinyOpt {lang === 'en' ? 'Desktop' : '桌面版'}</th>
          </tr>
        </thead>
        <tbody>
          {tc.comparison_rows.map((row: { feature: string; online: string; tinyopt: string }) => (
            <tr class="border-b border-primary-400/20 last:border-0">
              <td class="px-4 py-3 font-medium text-white/90">{row.feature}</td>
              <td class="px-4 py-3 text-primary-100">{row.online}</td>
              <td class="px-4 py-3 font-medium text-white">{row.tinyopt}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="text-center">
      <a href={downloadHref} class="inline-flex items-center gap-2 rounded-lg bg-white px-8 py-3 text-sm font-semibold text-primary-700 shadow-lg hover:bg-primary-50 transition-all">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        {tc.button}
      </a>
    </div>
  </div>
</section>
