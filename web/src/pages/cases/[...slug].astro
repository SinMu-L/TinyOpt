---
import Layout from '@/layouts/Layout.astro';
import AuthorInfo from '@/components/AuthorInfo.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const items = await getCollection('cases');
  return items
    .filter((c) => c.data.lang === 'en' && !c.data.draft && c.data.date <= new Date())
    .map((item) => ({
      params: { slug: item.id },
      props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const allItems = await getCollection('cases');
const translationKey = item.data.translationKey;
let langHref: string | undefined;
if (translationKey) {
  const zhItem = allItems.find((p) => p.data.translationKey === translationKey && p.data.lang === 'zh');
  langHref = zhItem ? `/zh/cases/${zhItem.id}/` : '/zh/cases/';
} else {
  langHref = '/zh/cases/';
}
---

<Layout
  title={item.data.title}
  description={item.data.description}
  lang={item.data.lang}
  langHref={langHref}
  pageType="article"
  articleDate={item.data.date.toISOString()}
  articleAuthor="TinyOpt Team"
  articleImage={item.data.image}
  ogImage={item.data.image}
>
  <article class="bg-white py-12 sm:py-20">
    <div class="mx-auto max-w-3xl px-4">
      <div class="mb-2 text-sm text-gray-400">{item.data.date.toLocaleDateString('en-US')}</div>
      <h1 class="mb-6 text-2xl sm:text-3xl font-bold text-gray-900">{item.data.title}</h1>
      <div class="prose prose-gray max-w-none">
        <Content />
      </div>
      <AuthorInfo lang={item.data.lang} />
    </div>
  </article>
</Layout>
