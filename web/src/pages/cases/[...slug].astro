---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('cases');
  return items
    .filter((c) => !c.data.draft)
    .map((item) => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<Layout title={item.data.title} description={item.data.description} lang={item.data.lang}>
  <article class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4">
      <div class="mb-2 text-sm text-gray-400">{item.data.date.toLocaleDateString('zh-CN')}</div>
      <h1 class="mb-6 text-3xl font-bold text-gray-900">{item.data.title}</h1>
      <div class="prose prose-gray max-w-none">
        <Content />
      </div>
    </div>
  </article>
</Layout>
