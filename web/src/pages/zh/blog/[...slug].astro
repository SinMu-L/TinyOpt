---
import Layout from '@/layouts/Layout.astro';
import ArchiveBanner from '@/components/ArchiveBanner.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => p.data.lang === 'zh' && !p.data.draft && p.data.date <= new Date())
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const translationKey = post.data.translationKey;

const relatedPosts = allPosts
  .filter((p) => p.data.lang === 'zh' && !p.data.draft && !p.data.noindex && p.id !== post.id && p.data.date <= new Date())
  .map((p) => ({
    post: p,
    score: post.data.tags ? post.data.tags.filter((t) => p.data.tags?.includes(t)).length : 0,
  }))
  .filter((p) => p.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.date.getTime() - a.post.data.date.getTime())
  .slice(0, 3)
  .map((p) => p.post);
let langHref: string | undefined;
if (translationKey) {
  const enPost = allPosts.find((p) => p.data.translationKey === translationKey && p.data.lang === 'en');
  langHref = enPost ? `/blog/${enPost.id}/` : '/blog/';
} else {
  langHref = '/blog/';
}
---

<Layout
  title={post.data.title}
  description={post.data.description}
  lang={post.data.lang}
  langHref={langHref}
  pageType="article"
  articleDate={post.data.date.toISOString()}
  articleAuthor="TinyOpt Team"
  articleTags={post.data.tags}
  articleImage={post.data.image}
  ogImage={post.data.image}
  noindex={post.data.noindex}
>
  <article class="bg-white py-12 sm:py-20">
    <div class="mx-auto max-w-3xl px-4">
      {post.data.noindex && <ArchiveBanner lang={post.data.lang} />}
      <div class="mb-2 text-sm text-gray-400">{post.data.date.toLocaleDateString('zh-CN')}</div>
      <h1 class="mb-6 text-2xl sm:text-3xl font-bold text-gray-900">{post.data.title}</h1>
      {post.data.tags && (
        <div class="mb-8 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded bg-primary-50 px-2 py-0.5 text-xs text-primary-600">{tag}</span>
          ))}
        </div>
      )}
      <div class="prose prose-gray max-w-none">
        <Content />
      </div>
    </div>
  </article>
  {relatedPosts.length > 0 && (
    <section class="bg-gray-50 py-12">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="mb-8 text-2xl font-bold text-gray-900">相关文章</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {relatedPosts.map((rp) => (
            <a href={`/zh/blog/${rp.id}/`} class="group rounded-xl border border-gray-100 bg-white p-5 transition-all hover:-translate-y-1 hover:shadow-md">
              <div class="mb-2 text-xs text-gray-400">{rp.data.date.toLocaleDateString('zh-CN')}</div>
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{rp.data.title}</h3>
              <p class="mt-2 text-xs text-gray-500 line-clamp-2">{rp.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
