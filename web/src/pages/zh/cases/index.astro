---
import Layout from '@/layouts/Layout.astro';
import { translation } from '@/i18n/utils';
import { getCollection } from 'astro:content';

const _ = translation('zh');
const cases = (await getCollection('cases'))
  .filter((c) => c.data.lang === 'zh' && !c.data.draft && c.data.date <= new Date())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title={_.cases.title} description={_.meta.cases} lang="zh">
  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="mb-4 text-3xl font-bold text-gray-900">{_.cases.title}</h1>
      <p class="mb-10 text-gray-600">{_.cases.subtitle}</p>

      <div class="grid gap-8 md:grid-cols-2">
        {cases.map((c) => (
          <a href={`/zh/cases/${c.id}/`} class="group rounded-xl border border-gray-100 p-6 transition-all hover:-translate-y-1 hover:shadow-md">
            <h2 class="mb-2 text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{c.data.title}</h2>
            <p class="text-sm text-gray-500">{c.data.description}</p>
            <div class="mt-4 text-sm font-medium text-primary-600">{_.cases.read_more} →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
