---
import Layout from '@/layouts/Layout.astro';
import { translation } from '@/i18n/utils';

const _ = translation('zh');
const ti = _.tools.index;
---

<Layout
  title={ti.title}
  description={_.meta.toolsIndex}
  lang="zh"
  pageType="page"
>
  <section class="bg-white py-12 sm:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="mb-2 text-3xl font-bold text-gray-900 text-center">{ti.title}</h1>
      <p class="mb-10 text-gray-500 text-center">{ti.subtitle}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {ti.tools.map((tool: { title: string; desc: string; link: string; icon: string }) => (
          <a href={tool.link} class="group rounded-xl border border-gray-200 bg-white p-6 hover:shadow-lg hover:border-primary-300 transition-all">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary-50 text-primary-600">
                {tool.icon === 'compress' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                )}
                {tool.icon === 'watermark' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                )}
                {tool.icon === 'folder' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
                  </svg>
                )}
              </div>
              <div>
                <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{tool.title}</h2>
                <p class="mt-1 text-sm text-gray-500">{tool.desc}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary-600">
                  使用工具
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">为什么用浏览器内的图片工具？</h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          本页所有工具都通过 WebAssembly 完全在你的浏览器中运行，图片不会离开你的设备。适合不想安装桌面软件、也不愿把照片上传到云服务器的快速一次性处理：选好格式、调一下质量，几秒就能下载结果。
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          如果你每周要处理上百张图片，<a href="/zh/download/" class="text-primary-600 underline">Windows 桌面版</a> 在同一引擎之上额外提供批量压缩、9 种格式互转、批量重命名与多 Key 轮转。
        </p>

        <h2 class="text-2xl font-bold text-gray-900 mb-4">常见使用场景</h2>
        <ul class="list-disc pl-6 space-y-2 text-gray-600 mb-8">
          <li><strong>网页 WebP 优化</strong> — 压缩商品图与博客配图，让页面加载更快、排名更好。</li>
          <li><strong>带水印的图库</strong> — 在公开分享前为作品集或店铺图片加上保护水印。</li>
          <li><strong>社交快速压缩</strong> — 不用打开 Photoshop，批量压一批用于邮件或社媒。</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mb-4">常见问题</h2>
        <div class="space-y-4">
          <div>
            <h3 class="font-semibold text-gray-900">我的图片会被上传到服务器吗？</h3>
            <p class="text-gray-600">不会。所有压缩与水印都通过 WebAssembly 和 Canvas API 在浏览器本地完成，文件不会离开你的设备。</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">支持哪些格式？</h3>
            <p class="text-gray-600">输入：JPEG、PNG、WebP、AVIF、GIF、BMP、TIFF。输出：JPEG、PNG、WebP。</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">有文件大小限制吗？</h3>
            <p class="text-gray-600">没有上传限制，唯一约束是你浏览器的可用内存。</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">真的免费吗？</h3>
            <p class="text-gray-600">是的。无需注册、无水印、无使用上限。工具完全开源，且全部在浏览器内运行。</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
