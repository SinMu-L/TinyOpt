---
import Layout from '@/layouts/Layout.astro';
import WatermarkTool from '@/components/WatermarkTool.tsx';
import FaqAccordion from '@/components/FaqAccordion.astro';
import DesktopCtaBanner from '@/components/DesktopCtaBanner.astro';
import { translation } from '@/i18n/utils';

const _ = translation('zh');
const tc = _.tools.watermark;
---

<Layout
  title={tc.title}
  description={tc.description}
  lang="zh"
  pageType="page"
  faqItems={tc.faq_items}
>
  <WatermarkTool
    client:load
    t={{
      title: "在线图片水印工具",
      subtitle: "为多张照片添加文字或图片水印——全部在浏览器中完成",
      uploadHint: "点击或拖拽图片到此处",
      uploadFormats: "支持 PNG、JPEG、WebP、BMP、TIFF——可一次添加多张",
      typeLabel: "水印类型",
      textType: "文字",
      imageType: "图片",
      textPlaceholder: "输入水印文字...",
      fontSize: "字号",
      color: "颜色",
      opacity: "透明度",
      rotation: "旋转角度",
      position: "位置",
      imageWatermarkHint: "点击上传 Logo/图片",
      imageScale: "缩放比例",
      preview: "预览",
      applyAll: "应用到全部并处理",
      applying: "处理中...",
      processing: "正在处理您的图片...",
      results: "处理结果",
      viewImage: "查看图片",
      downloadSingle: "下载",
      downloadAllZip: "打包下载全部 ZIP",
      backToSettings: "返回设置",
      clearAll: "清空全部",
      noImages: "未选择图片",
      dragHint: "拖动预览中的水印可调整位置",
    }}
  />

  <section class="bg-gray-50 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-10 text-center text-2xl sm:text-3xl font-bold text-gray-900">{tc.how_title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {tc.how_steps.map((step: { title: string; desc: string }, i: number) => (
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 text-lg font-bold text-white">{i + 1}</div>
            <h3 class="mb-2 font-semibold text-gray-900">{step.title}</h3>
            <p class="text-sm text-gray-500">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-10 text-center text-2xl sm:text-3xl font-bold text-gray-900">{tc.why_title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {tc.why_items.map((item: { title: string; desc: string }) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 hover:shadow-md transition-shadow">
            <h3 class="mb-2 font-semibold text-gray-900">{item.title}</h3>
            <p class="text-sm text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <DesktopCtaBanner lang="zh" />

  <section class="bg-gray-50 py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="mb-8 text-center text-2xl sm:text-3xl font-bold text-gray-900">{tc.faq_title}</h2>
      <FaqAccordion items={tc.faq_items} />
    </div>
  </section>
</Layout>
