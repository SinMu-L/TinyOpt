---
import Layout from '@/layouts/Layout.astro';
import { translation } from '@/i18n/utils';

const _ = translation('en');
---

<Layout title={_.contact.title} description={_.site.description} lang="en">
  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="mb-4 text-3xl font-bold text-gray-900">{_.contact.title}</h1>
      <p class="mb-10 text-gray-600">{_.contact.subtitle}</p>

      <div class="grid gap-6 sm:grid-cols-3">
        <div class="rounded-xl border border-gray-100 p-6 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-50 text-primary-600">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="mb-2 font-semibold text-gray-900">{_.contact.email}</h3>
          <p class="text-sm text-gray-500">sinmu.li@foxmail.com</p>
        </div>

        <div class="rounded-xl border border-gray-100 p-6 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-50 text-primary-600">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="mb-2 font-semibold text-gray-900">{_.contact.response_time}</h3>
        </div>
      </div>
    </div>
  </section>
</Layout>
