---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('cases');
  return items
    .filter((c) => c.data.lang === 'en' && !c.data.draft && c.data.date <= new Date())
    .map((item) => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await item.render();

const allItems = await getCollection('cases');
const translationKey = item.data.translationKey;
let langHref: string | undefined;
if (translationKey) {
  const zhItem = allItems.find((p) => p.data.translationKey === translationKey && p.data.lang === 'zh');
  langHref = zhItem ? `/cases/${zhItem.slug}/` : '/cases/';
} else {
  langHref = '/cases/';
}
---

<Layout title={item.data.title} description={item.data.description} lang={item.data.lang} langHref={langHref}>
  <article class="bg-white py-12 sm:py-20">
    <div class="mx-auto max-w-3xl px-4">
      <div class="mb-2 text-sm text-gray-400">{item.data.date.toLocaleDateString('en-US')}</div>
      <h1 class="mb-6 text-2xl sm:text-3xl font-bold text-gray-900">{item.data.title}</h1>
      <div class="prose prose-gray max-w-none">
        <Content />
      </div>
    </div>
  </article>
</Layout>
