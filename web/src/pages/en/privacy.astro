---
import Layout from '@/layouts/Layout.astro';
import { translation } from '@/i18n/utils';

const _ = translation('en');
---

<Layout title={_.privacy.title} description={_.site.description} lang="en">
  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="mb-2 text-3xl font-bold text-gray-900">{_.privacy.title}</h1>
      <p class="mb-8 text-sm text-gray-400">{_.privacy.last_updated}</p>

      <div class="space-y-4 text-sm leading-relaxed text-gray-600">
        {_.privacy.content.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </section>
</Layout>
