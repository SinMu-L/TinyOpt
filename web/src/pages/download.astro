---
import Layout from '@/layouts/Layout.astro';
import { translation } from '@/i18n/utils';

const _ = translation('zh');
---

<Layout title={_.download.title} description={_.site.description} lang="zh">
  <section class="bg-white py-12 sm:py-20">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="mb-4 text-2xl sm:text-3xl font-bold text-gray-900">{_.download.title}</h1>
      <p class="mb-10 text-gray-600">{_.download.subtitle}</p>

      <div class="mb-12 rounded-xl border border-gray-200 bg-gradient-to-r from-primary-50 to-blue-50 p-6 sm:p-8 text-center">
        <div class="mb-2 text-sm text-gray-500">{_.download.latest_version} · {_.download.latest_date}</div>
        <a href="https://pan.baidu.com/s/1IeCqkxYjw6DbhdYayQTKgg?pwd=jv8f" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-8 py-3 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 transition-all">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          {_.download.download_windows}
        </a>
      </div>

      <h2 class="mb-6 text-2xl font-bold text-gray-900">{_.download.changelog}</h2>
      <div class="space-y-4">
        {_.download.changelog_items.map((item) => (
          <div class="rounded-lg border border-gray-100 p-5">
            <div class="mb-2 flex items-center gap-3">
              <span class="rounded bg-primary-100 px-2 py-0.5 text-xs font-semibold text-primary-700">{item.version}</span>
              <span class="text-xs text-gray-400">{item.date}</span>
            </div>
            <ul class="space-y-1">
              {item.changes.map((change) => (
                <li class="text-sm text-gray-600">· {change}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
