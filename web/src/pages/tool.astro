---
import Layout from '@/layouts/Layout.astro';
const _ = (await import('@/i18n/utils')).translation('zh');
const tool = _.tool;
const pathname = '/tool/';
---

<Layout
  title={tool.title}
  description={tool.subtitle}
  lang="zh"
  langHref={'/en/tool/'}
  canonical={'https://seojeck.com' + pathname}
>
  <div class="mx-auto flex min-h-[calc(100vh-64px)] max-w-6xl flex-col px-4 py-4 lg:flex-row lg:gap-6 lg:py-6">
    <!-- Left: Upload + Options -->
    <div class="flex flex-col gap-4 lg:w-1/2">
      <div>
        <h1 class="text-xl font-bold text-gray-900 sm:text-2xl">{tool.title}</h1>
        <p class="mt-0.5 text-sm text-gray-500">{tool.subtitle}</p>
      </div>

      <div id="dropzone" class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-gray-300 bg-white px-4 py-6 text-center transition-colors hover:border-primary-400 hover:bg-primary-50/30">
        <svg class="mb-3 h-8 w-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        <p class="text-sm font-medium text-gray-600">{tool.upload_area}</p>
        <p class="mt-1 text-xs text-gray-400">{tool.upload_hint}</p>
        <input id="file-input" type="file" accept="image/png,image/jpeg,image/webp,image/avif,image/gif,image/tiff,image/bmp" class="hidden" />
        <div id="file-preview" class="mt-3 hidden">
          <img id="preview-img" class="mx-auto max-h-24 rounded-lg border border-gray-200 object-contain shadow-sm" />
          <p id="file-info" class="mt-1 text-xs text-gray-500"></p>
        </div>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
        <div class="flex gap-4">
          <div class="flex-1">
            <label class="mb-1 block text-xs font-medium text-gray-500">{tool.format_label}</label>
            <select id="format-select" class="w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
              <option value="original">{tool.format_original}</option>
              <option value="jpeg">JPEG</option>
              <option value="png">PNG</option>
              <option value="webp">WebP</option>
              <option value="avif">AVIF</option>
              <option value="gif">GIF</option>
            </select>
          </div>
          <div class="flex-1">
            <label class="mb-1 block text-xs font-medium text-gray-500">{tool.resize_label}</label>
            <select id="resize-method" class="w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
              <option value="">{tool.resize_none}</option>
              <option value="fit">{tool.resize_fit}</option>
              <option value="scale">{tool.resize_scale}</option>
              <option value="cover">{tool.resize_cover}</option>
              <option value="thumb">{tool.resize_thumb}</option>
            </select>
          </div>
        </div>

        <div id="resize-dimensions" class="mt-3 hidden">
          <div class="flex gap-3">
            <div class="flex-1">
              <input id="resize-width" type="number" min="0" max="10000" placeholder={tool.width_auto} class="w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" />
            </div>
            <div class="flex-1">
              <input id="resize-height" type="number" min="0" max="10000" placeholder={tool.height_auto} class="w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" />
            </div>
          </div>
        </div>

        <div class="mt-3 flex items-center gap-3">
          <button id="compress-btn" disabled class="flex-1 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white opacity-50 transition-all hover:bg-primary-700 disabled:cursor-not-allowed">
            {tool.compress_btn}
          </button>
          <a href="/download/" class="shrink-0 text-xs text-amber-600 underline hover:text-amber-700">{tool.desktop_link}</a>
        </div>
      </div>
    </div>

    <!-- Right: Result / Progress -->
    <div class="mt-4 flex flex-col lg:mt-0 lg:w-1/2">
      <!-- Placeholder -->
      <div id="placeholder-area" class="flex flex-1 items-center justify-center rounded-xl border-2 border-dashed border-gray-200 bg-white px-4 py-8 text-center">
        <div>
          <svg class="mx-auto mb-3 h-10 w-10 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
          </svg>
          <p class="text-sm text-gray-400">{tool.upload_hint}</p>
        </div>
      </div>

      <!-- Progress -->
      <div id="progress-area" class="hidden rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-gray-700">{tool.compressing}</span>
          <span id="progress-percent" class="text-gray-400">0%</span>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-gray-100">
          <div id="progress-bar" class="h-full w-0 rounded-full bg-primary-500 transition-all duration-300"></div>
        </div>
      </div>

      <!-- Result -->
      <div id="result-area" class="hidden flex flex-1 flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
        <div id="result-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"></div>
        <div id="result-success" class="flex flex-1 flex-col">
          <div class="mb-3 flex flex-1 items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-gray-50">
            <img id="result-img" class="max-h-48 object-contain" />
          </div>
          <div class="mb-3 grid grid-cols-3 gap-2 text-xs">
            <div class="rounded-lg bg-gray-50 px-3 py-2 text-center">
              <div class="text-gray-500">{tool.original_size}</div>
              <div id="original-size-display" class="font-semibold text-gray-700"></div>
            </div>
            <div class="rounded-lg bg-green-50 px-3 py-2 text-center">
              <div class="text-gray-500">{tool.compressed_size}</div>
              <div id="compressed-size-display" class="font-semibold text-green-700"></div>
            </div>
            <div class="rounded-lg bg-blue-50 px-3 py-2 text-center">
              <div class="text-gray-500">{tool.savings}</div>
              <div id="savings-display" class="font-semibold text-blue-700"></div>
            </div>
          </div>
          <div class="flex gap-2">
            <a id="download-link" class="flex-1 rounded-lg bg-primary-600 px-3 py-2 text-center text-sm font-semibold text-white transition-all hover:bg-primary-700">
              {tool.download_btn}
            </a>
            <button id="compress-again-btn" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-50">
              {tool.compress_again}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ tool }}>
(function() {
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file-input');
  const filePreview = document.getElementById('file-preview');
  const previewImg = document.getElementById('preview-img');
  const fileInfo = document.getElementById('file-info');
  const formatSelect = document.getElementById('format-select');
  const resizeMethod = document.getElementById('resize-method');
  const resizeDimensions = document.getElementById('resize-dimensions');
  const resizeWidth = document.getElementById('resize-width');
  const resizeHeight = document.getElementById('resize-height');
  const compressBtn = document.getElementById('compress-btn');
  const progressArea = document.getElementById('progress-area');
  const progressBar = document.getElementById('progress-bar');
  const progressPercent = document.getElementById('progress-percent');
  const placeholderArea = document.getElementById('placeholder-area');
  const resultArea = document.getElementById('result-area');
  const resultError = document.getElementById('result-error');
  const resultSuccess = document.getElementById('result-success');
  const resultImg = document.getElementById('result-img');
  const originalSizeDisplay = document.getElementById('original-size-display');
  const compressedSizeDisplay = document.getElementById('compressed-size-display');
  const savingsDisplay = document.getElementById('savings-display');
  const downloadLink = document.getElementById('download-link');
  const compressAgainBtn = document.getElementById('compress-again-btn');

  let selectedFile = null;
  let compressedBlob = null;

  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    const kb = bytes / 1024;
    if (kb < 1024) return kb.toFixed(1) + ' KB';
    return (kb / 1024).toFixed(2) + ' MB';
  }

  function updateCompressBtn() {
    compressBtn.disabled = !selectedFile;
    compressBtn.classList.toggle('opacity-50', !selectedFile);
  }

  function handleFile(file) {
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      alert(tool.error_file_type);
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      alert(tool.error_file_size);
      return;
    }
    selectedFile = file;
    const reader = new FileReader();
    reader.onload = function(e) {
      previewImg.src = e.target.result;
      fileInfo.textContent = file.name + ' — ' + formatSize(file.size);
      filePreview.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
    updateCompressBtn();
  }

  dropzone.addEventListener('click', function() { fileInput.click(); });

  dropzone.addEventListener('dragover', function(e) {
    e.preventDefault();
    dropzone.classList.add('border-primary-400', 'bg-primary-50/30');
  });

  dropzone.addEventListener('dragleave', function() {
    dropzone.classList.remove('border-primary-400', 'bg-primary-50/30');
  });

  dropzone.addEventListener('drop', function(e) {
    e.preventDefault();
    dropzone.classList.remove('border-primary-400', 'bg-primary-50/30');
    const file = e.dataTransfer.files[0];
    fileInput.files = e.dataTransfer.files;
    handleFile(file);
  });

  fileInput.addEventListener('change', function() {
    handleFile(this.files[0]);
  });

  resizeMethod.addEventListener('change', function() {
    resizeDimensions.classList.toggle('hidden', !this.value);
  });

  compressBtn.addEventListener('click', async function() {
    if (!selectedFile) return;

    compressBtn.disabled = true;
    compressBtn.textContent = tool.compressing;
    placeholderArea.classList.add('hidden');
    resultArea.classList.add('hidden');
    resultError.classList.add('hidden');
    resultSuccess.classList.remove('hidden');
    progressArea.classList.remove('hidden');
    progressBar.style.width = '10%';
    progressPercent.textContent = '10%';

    const buffer = await selectedFile.arrayBuffer();

    const headers = {
      'Content-Type': 'application/octet-stream',
      'X-Filename': encodeURIComponent(selectedFile.name),
      'X-Format': formatSelect.value,
    };

    const method = resizeMethod.value;
    if (method) {
      headers['X-Resize-Method'] = method;
      const w = parseInt(resizeWidth.value);
      const h = parseInt(resizeHeight.value);
      if (w > 0) headers['X-Resize-Width'] = String(w);
      if (h > 0) headers['X-Resize-Height'] = String(h);
    }

    progressBar.style.width = '30%';
    progressPercent.textContent = '30%';

    try {
      const response = await fetch('/api/compress/', {
        method: 'POST',
        headers: headers,
        body: buffer,
      });

      progressBar.style.width = '80%';
      progressPercent.textContent = '80%';

      if (!response.ok) {
        const errData = await response.json().catch(function() { return {}; });
        throw new Error(errData.error || 'HTTP ' + response.status);
      }

      compressedBlob = await response.blob();
      const originalSize = parseInt(response.headers.get('X-Original-Size') || '0');
      const compressedSize = parseInt(response.headers.get('X-Compressed-Size') || '0');

      progressBar.style.width = '100%';
      progressPercent.textContent = '100%';

      setTimeout(function() {
        progressArea.classList.add('hidden');
        progressBar.style.width = '0%';
        progressPercent.textContent = '0%';

        const blobUrl = URL.createObjectURL(compressedBlob);
        resultImg.src = blobUrl;
        originalSizeDisplay.textContent = formatSize(originalSize);
        compressedSizeDisplay.textContent = formatSize(compressedSize);
        var savings = originalSize > 0
          ? ((1 - compressedSize / originalSize) * 100).toFixed(1) + '%'
          : '-';
        savingsDisplay.textContent = savings;

        var ext = formatSelect.value === 'original'
          ? (selectedFile.name.split('.').pop() || 'png')
          : formatSelect.value;
        downloadLink.href = blobUrl;
        downloadLink.download = 'compressed.' + ext;

        resultArea.classList.remove('hidden');
        compressBtn.disabled = false;
        compressBtn.textContent = tool.compress_btn;
      }, 500);
    } catch (err) {
      progressArea.classList.add('hidden');
      progressBar.style.width = '0%';
      progressPercent.textContent = '0%';

      resultError.textContent = err.message;
      resultError.classList.remove('hidden');
      resultSuccess.classList.add('hidden');
      resultArea.classList.remove('hidden');
      compressBtn.disabled = false;
      compressBtn.textContent = tool.compress_btn;
    }
  });

  compressAgainBtn.addEventListener('click', function() {
    resultArea.classList.add('hidden');
    placeholderArea.classList.remove('hidden');
    resultError.classList.add('hidden');
    selectedFile = null;
    compressedBlob = null;
    fileInput.value = '';
    filePreview.classList.add('hidden');
    updateCompressBtn();
  });
})();
</script>
