---
import Layout from '@/layouts/Layout.astro';
import { translation } from '@/i18n/utils';
import { getCollection } from 'astro:content';

const _ = translation('zh');
const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === 'zh' && !p.data.draft && p.data.date <= new Date())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title={_.blog.title} description={_.blog.subtitle} lang="zh">
  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="mb-4 text-3xl font-bold text-gray-900">{_.blog.title}</h1>
      <p class="mb-10 text-gray-600">{_.blog.subtitle}</p>

      {posts.length === 0 ? (
        <p class="text-gray-400">{_.blog.no_posts}</p>
      ) : (
        <div class="grid gap-8 md:grid-cols-2">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="group rounded-xl border border-gray-100 p-6 transition-all hover:-translate-y-1 hover:shadow-md">
              <div class="mb-3 text-xs text-gray-400">{post.data.date.toLocaleDateString('zh-CN')}</div>
              <h2 class="mb-2 text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{post.data.title}</h2>
              <p class="text-sm text-gray-500">{post.data.description}</p>
              {post.data.tags && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-500">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
