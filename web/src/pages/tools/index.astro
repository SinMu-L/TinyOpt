---
import Layout from '@/layouts/Layout.astro';
import { translation } from '@/i18n/utils';

const _ = translation('en');
const ti = _.tools.index;
---

<Layout
  title={ti.title}
  description={_.meta.toolsIndex}
  lang="en"
  pageType="page"
>
  <section class="bg-white py-12 sm:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="mb-2 text-3xl font-bold text-gray-900 text-center">{ti.title}</h1>
      <p class="mb-10 text-gray-500 text-center">{ti.subtitle}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {ti.tools.map((tool: { title: string; desc: string; link: string; icon: string }) => (
          <a href={tool.link} class="group rounded-xl border border-gray-200 bg-white p-6 hover:shadow-lg hover:border-primary-300 transition-all">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary-50 text-primary-600">
                {tool.icon === 'compress' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                )}
                {tool.icon === 'watermark' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                )}
                {tool.icon === 'folder' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
                  </svg>
                )}
              </div>
              <div>
                <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{tool.title}</h2>
                <p class="mt-1 text-sm text-gray-500">{tool.desc}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary-600">
                  Use Tool
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Why use an in-browser image tool?</h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          Every tool on this page runs entirely inside your browser using WebAssembly — your images never leave the device. That makes it ideal for quick, one-off edits when you don't want to install desktop software or upload photos to a cloud server. Pick a format, tune the quality, and download the result in seconds.
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          Need to process hundreds of images every week? The <a href="/download/" class="text-primary-600 underline">Windows desktop app</a> adds batch compression, 9-format conversion, bulk renaming and multi-key rotation on top of the same engine.
        </p>

        <h2 class="text-2xl font-bold text-gray-900 mb-4">Common use cases</h2>
        <ul class="list-disc pl-6 space-y-2 text-gray-600 mb-8">
          <li><strong>WebP for the web</strong> — shrink product and blog images so pages load faster and rank better.</li>
          <li><strong>Watermarked galleries</strong> — protect portfolio or store photos before sharing them publicly.</li>
          <li><strong>Quick social resizing</strong> — compress a batch for email or social without opening Photoshop.</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mb-4">Frequently asked questions</h2>
        <div class="space-y-4">
          <div>
            <h3 class="font-semibold text-gray-900">Are my images uploaded to a server?</h3>
            <p class="text-gray-600">No. All compression and watermarking run locally in your browser via WebAssembly and the Canvas API. Files never leave your device.</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">What formats are supported?</h3>
            <p class="text-gray-600">Input: JPEG, PNG, WebP, AVIF, GIF, BMP, TIFF. Output: JPEG, PNG, WebP.</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Is there a file size limit?</h3>
            <p class="text-gray-600">No upload limit — the only constraint is your browser's available memory.</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Is it really free?</h3>
            <p class="text-gray-600">Yes. No account, no watermarks, no usage caps. The tools are open source and run entirely in your browser.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
