---
import Layout from '@/layouts/Layout.astro';
import WatermarkTool from '@/components/WatermarkTool.tsx';
import FaqAccordion from '@/components/FaqAccordion.astro';
import DesktopCtaBanner from '@/components/DesktopCtaBanner.astro';
import { translation } from '@/i18n/utils';

const _ = translation('en');
const tc = _.tools.watermark;
---

<Layout
  title={tc.title}
  description={tc.description}
  lang="en"
  pageType="page"
  faqItems={tc.faq_items}
>
  <WatermarkTool
    client:load
    t={{
      title: "Online Image Watermark Tool",
      subtitle: "Add text or image watermarks to multiple photos — all in your browser",
      uploadHint: "Click or drag images here",
      uploadFormats: "Supports PNG, JPEG, WebP, BMP, TIFF — add multiple files at once",
      typeLabel: "Watermark Type",
      textType: "Text",
      imageType: "Image",
      textPlaceholder: "Enter watermark text...",
      fontSize: "Font Size",
      color: "Color",
      opacity: "Opacity",
      rotation: "Rotation",
      position: "Position",
      imageWatermarkHint: "Click to upload logo/image",
      imageScale: "Scale",
      preview: "Preview",
      applyAll: "Apply to All & Process",
      applying: "Processing...",
      processing: "Processing your images...",
      results: "Results",
      viewImage: "View Image",
      downloadSingle: "Download",
      downloadAllZip: "Download All as ZIP",
      backToSettings: "Back to Settings",
      clearAll: "Clear All",
      noImages: "No images selected",
    }}
  />

  <!-- How It Works -->
  <section class="bg-gray-50 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-10 text-center text-2xl sm:text-3xl font-bold text-gray-900">{tc.how_title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {tc.how_steps.map((step: { title: string; desc: string }, i: number) => (
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 text-lg font-bold text-white">{i + 1}</div>
            <h3 class="mb-2 font-semibold text-gray-900">{step.title}</h3>
            <p class="text-sm text-gray-500">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Use Our Watermark Tool -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-10 text-center text-2xl sm:text-3xl font-bold text-gray-900">{tc.why_title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {tc.why_items.map((item: { title: string; desc: string }) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 hover:shadow-md transition-shadow">
            <h3 class="mb-2 font-semibold text-gray-900">{item.title}</h3>
            <p class="text-sm text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Desktop CTA -->
  <DesktopCtaBanner lang="en" />

  <!-- FAQ -->
  <section class="bg-gray-50 py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="mb-8 text-center text-2xl sm:text-3xl font-bold text-gray-900">{tc.faq_title}</h2>
      <FaqAccordion items={tc.faq_items} />
    </div>
  </section>
</Layout>
