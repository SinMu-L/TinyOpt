---
import Layout from '@/layouts/Layout.astro';
import BatchCompressTool from '@/components/BatchCompressTool.tsx';
import DesktopCtaBanner from '@/components/DesktopCtaBanner.astro';
import { translation } from '@/i18n/utils';

const _ = translation('en');
const tc = _.tools.batch_compress;
---

<Layout
  title={tc.title}
  description={tc.description}
  lang="en"
  pageType="page"
>
  <BatchCompressTool
    client:load
    t={tc}
  />

  <section class="bg-white py-12">
    <div class="mx-auto max-w-6xl px-4">
      <div class="rounded-xl border border-gray-200 bg-white p-8">
        <h2 class="mb-4 text-2xl font-bold text-gray-900">{tc.section_title}</h2>
        <p class="text-sm text-gray-500 leading-relaxed">{tc.section_desc}</p>
      </div>
    </div>
  </section>

  <DesktopCtaBanner lang="en" />
</Layout>
