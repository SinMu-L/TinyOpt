---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { translation } from '@/i18n/utils';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  lang?: 'zh' | 'en';
  langHref?: string;
  ogImage?: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, description, lang = 'zh', langHref, ogImage, noindex, canonical } = Astro.props;
const _ = translation(lang);
const siteTitle = _.site.title;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const locale = lang === 'en' ? 'en-US' : 'zh-CN';
const baseUrl = 'https://seojeck.com';
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={locale} />
  <meta property="og:site_name" content={siteTitle} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {canonical && <link rel="canonical" href={canonical} />}

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": siteTitle,
    "operatingSystem": "Windows 10/11",
    "applicationCategory": "MultimediaApplication",
    "description": description,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "author": {
      "@type": "Person",
      "name": "TinyOpt Team"
    }
  })}></script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
  <link rel="alternate icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/images/logo.svg" />

  <!-- Alternate language links -->
  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="TinyOpt - 新闻动态" href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title="TinyOpt - Blog" href="/en/rss.xml" />

  <link rel="alternate" hreflang="x-default" href={baseUrl} />
  <link rel="alternate" hreflang="zh-CN" href={`${baseUrl}${Astro.url.pathname.startsWith('/en') ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname}`} />
  <link rel="alternate" hreflang="en-US" href={`${baseUrl}${Astro.url.pathname.startsWith('/en') ? Astro.url.pathname : '/en' + (Astro.url.pathname === '/' ? '' : Astro.url.pathname)}`} />

  <!-- Google Analytics (loaded only with cookie consent) -->
  <script>
    window.__loadGA = function() {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-S9N29VS8B8';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S9N29VS8B8');
    };
    if (localStorage.getItem('cookie_consent') === 'accepted') {
      window.__loadGA();
    }
  </script>
</head>
<body class="flex min-h-screen flex-col">
  <Header lang={lang} langHref={langHref} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer lang={lang} />

  <!-- Cookie Consent Banner -->
  <div id="cookie-consent" class="fixed bottom-0 left-0 right-0 z-50 hidden border-t border-gray-200 bg-white px-4 py-4 shadow-lg lg:px-8">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-gray-600">
        {lang === 'en'
          ? 'We use cookies to improve your experience and for Google AdSense. By continuing, you agree to our '
          : '我们使用 Cookie 来提升您的体验并用于 Google AdSense。继续使用即表示您同意我们的 '}
        <a href={lang === 'en' ? '/en/privacy/' : '/privacy/'} class="underline hover:text-primary-600">{lang === 'en' ? 'Privacy Policy' : '隐私政策'}</a>
        {lang === 'en' ? ' and ' : ' 和 '}
        <a href={lang === 'en' ? '/en/terms/' : '/terms/'} class="underline hover:text-primary-600">{lang === 'en' ? 'Terms of Service' : '服务条款'}</a>.
      </p>
      <div class="flex shrink-0 gap-2">
        <button id="cookie-accept" class="rounded-lg bg-primary-600 px-5 py-2 text-xs font-semibold text-white hover:bg-primary-700 transition-all">{lang === 'en' ? 'Accept' : '接受'}</button>
        <button id="cookie-decline" class="rounded-lg border border-gray-300 bg-white px-5 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-50 transition-all">{lang === 'en' ? 'Decline' : '拒绝'}</button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      if (localStorage.getItem('cookie_consent')) return;
      var banner = document.getElementById('cookie-consent');
      if (!banner) return;
      banner.classList.remove('hidden');
      document.getElementById('cookie-accept').addEventListener('click', function() {
        localStorage.setItem('cookie_consent', 'accepted');
        window.__loadGA && window.__loadGA();
        banner.classList.add('hidden');
      });
      document.getElementById('cookie-decline').addEventListener('click', function() {
        localStorage.setItem('cookie_consent', 'declined');
        banner.classList.add('hidden');
      });
    })();
  </script>
</body>
</html>
