---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { translation } from '@/i18n/utils';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  lang?: 'zh' | 'en';
  langHref?: string;
  ogImage?: string;
  noindex?: boolean;
  canonical?: string;
  pageType?: 'home' | 'article' | 'page';
  articleDate?: string;
  articleModifiedDate?: string;
  articleAuthor?: string;
  articleTags?: string[];
  articleImage?: string;
  faqItems?: { q: string; a: string }[];
}

const {
  title, description, lang = 'en', langHref, ogImage, noindex, canonical,
  pageType = 'page',
  articleDate, articleModifiedDate, articleAuthor, articleTags, articleImage,
  faqItems,
} = Astro.props;
const _ = translation(lang);
const siteTitle = _.site.title;
const brandSuffix = pageType === 'article' ? 'TinyOpt' : siteTitle;
const fullTitle = title === siteTitle ? title : `${title} | ${brandSuffix}`;
const locale = lang === 'en' ? 'en-US' : 'zh-CN';
const baseUrl = 'https://seojeck.com';
const autoCanonical = canonical ?? `${baseUrl}${Astro.url.pathname}`;
const ogType = pageType === 'article' ? 'article' : 'website';
const authorName = articleAuthor ?? 'TinyOpt Team';
const defaultOgImage = `${baseUrl}/images/og-default.png`;
const ogImageUrl = ogImage ? (ogImage.startsWith('http') ? ogImage : `${baseUrl}${ogImage}`) : defaultOgImage;
const enPath = lang === 'zh'
  ? (langHref ?? (Astro.url.pathname.startsWith('/zh') ? Astro.url.pathname.replace(/^\/zh/, '') || '/' : Astro.url.pathname))
  : Astro.url.pathname;
const zhPath = lang === 'en'
  ? (langHref ?? (Astro.url.pathname === '/' ? '/zh/' : `/zh${Astro.url.pathname}`))
  : Astro.url.pathname;
const enHref = `${baseUrl}${enPath}`;
const zhHref = `${baseUrl}${zhPath}`;

function getDefaultSchema(baseUrl: string, siteTitle: string, description: string) {
  return {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": siteTitle,
    "url": baseUrl,
    "description": description,
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${baseUrl}/blog/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  };
}

function getHomeSchema(baseUrl: string, siteTitle: string, description: string, locale: string, faqItems?: { q: string; a: string }[]) {
  const schemas: any[] = [
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": siteTitle,
      "url": baseUrl,
      "description": description,
      "email": "sinmu8191@gmail.com",
      "sameAs": ["https://github.com/SinMu-L/TinyOpt"]
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteTitle,
      "url": baseUrl,
      "inLanguage": locale,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${baseUrl}/blog/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": siteTitle,
      "operatingSystem": "Windows 10/11",
      "applicationCategory": "MultimediaApplication",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@type": "Person",
        "name": "TinyOpt Team"
      }
    }
  ];

  if (faqItems && faqItems.length > 0) {
    schemas.push({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    });
  }

  return schemas.length === 1 ? schemas[0] : { "@context": "https://schema.org", "@graph": schemas };
}

function getArticleSchema(
  baseUrl: string, siteTitle: string, fullTitle: string, description: string,
  articleUrl: string, articleDate?: string, articleModifiedDate?: string,
  articleAuthor?: string, articleImage?: string, articleTags?: string[], locale?: string
) {
  const article: any = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": fullTitle,
    "description": description,
    "url": articleUrl,
    "author": {
      "@type": "Person",
      "name": articleAuthor ?? "TinyOpt Team"
    },
    "publisher": {
      "@type": "Organization",
      "name": siteTitle,
      "url": baseUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${baseUrl}/images/logo.svg`
      }
    }
  };

  if (articleDate) {
    article.datePublished = articleDate;
    article.dateModified = articleModifiedDate ?? articleDate;
  }
  if (articleImage) article.image = articleImage;
  if (locale) article.inLanguage = locale;
  if (articleTags && articleTags.length > 0) article.keywords = articleTags.join(", ");

  const breadcrumb: any = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": siteTitle, "item": baseUrl },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${baseUrl}/blog/` },
      { "@type": "ListItem", "position": 3, "name": fullTitle }
    ]
  };

  return { "@context": "https://schema.org", "@graph": [article, breadcrumb] };
}
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={autoCanonical} />
  <meta property="og:locale" content={locale} />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Article meta tags (for blog/case pages) -->
  {pageType === 'article' && articleDate && <meta property="article:published_time" content={articleDate} />}
  {pageType === 'article' && articleModifiedDate && <meta property="article:modified_time" content={articleModifiedDate} />}
  {pageType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}
  {pageType === 'article' && articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}

  <link rel="canonical" href={autoCanonical} />
  <link rel="alternate" type="text/markdown" title="LLMs full content" href="/llms-full.txt" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(
    pageType === 'home' ? getHomeSchema(baseUrl, siteTitle, description, locale, faqItems) :
    pageType === 'article' ? getArticleSchema(baseUrl, siteTitle, fullTitle, description, autoCanonical, articleDate, articleModifiedDate, articleAuthor, articleImage, articleTags, locale) :
    getDefaultSchema(baseUrl, siteTitle, description)
  )}></script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
  <link rel="alternate icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/images/logo.svg" />

  <!-- Alternate language links -->
  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="TinyOpt - Blog" href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title="TinyOpt - 新闻动态" href="/zh/rss.xml" />

  <link rel="alternate" hreflang="x-default" href={enHref} />
  <link rel="alternate" hreflang="en" href={enHref} />
  <link rel="alternate" hreflang="en-US" href={enHref} />
  <link rel="alternate" hreflang="zh-CN" href={zhHref} />
  <!-- Ahrefs Analytics (cookieless) -->
  <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="u7AA4DeV1SI8yuf2HXAuLw" async></script>

  <!-- Google Analytics (loaded only with cookie consent) -->
  <script>
    window.__loadGA = function() {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-S9N29VS8B8';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S9N29VS8B8');
    };
    if (localStorage.getItem('cookie_consent') === 'accepted') {
      window.__loadGA();
    }
  </script>
</head>
<body class="flex min-h-screen flex-col">
  <Header lang={lang} langHref={langHref} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer lang={lang} />

  <!-- Cookie Consent Banner -->
  <div id="cookie-consent" class="fixed bottom-0 left-0 right-0 z-50 hidden border-t border-gray-200 bg-white px-4 py-4 shadow-lg lg:px-8">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-gray-600">
        {lang === 'en'
          ? 'We use cookies to improve your experience and for analytics. By continuing, you agree to our '
          : '我们使用 Cookie 来提升您的体验并用于网站分析。继续使用即表示您同意我们的 '}
        <a href={lang === 'en' ? '/privacy/' : '/zh/privacy/'} class="underline hover:text-primary-600">{lang === 'en' ? 'Privacy Policy' : '隐私政策'}</a>
        {lang === 'en' ? ' and ' : ' 和 '}
        <a href={lang === 'en' ? '/terms/' : '/zh/terms/'} class="underline hover:text-primary-600">{lang === 'en' ? 'Terms of Service' : '服务条款'}</a>.
      </p>
      <div class="flex shrink-0 gap-2">
        <button id="cookie-accept" class="rounded-lg bg-primary-600 px-5 py-2 text-xs font-semibold text-white hover:bg-primary-700 transition-all">{lang === 'en' ? 'Accept' : '接受'}</button>
        <button id="cookie-decline" class="rounded-lg border border-gray-300 bg-white px-5 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-50 transition-all">{lang === 'en' ? 'Decline' : '拒绝'}</button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      if (localStorage.getItem('cookie_consent')) return;
      var banner = document.getElementById('cookie-consent');
      if (!banner) return;
      banner.classList.remove('hidden');
      document.getElementById('cookie-accept').addEventListener('click', function() {
        localStorage.setItem('cookie_consent', 'accepted');
        window.__loadGA && window.__loadGA();
        banner.classList.add('hidden');
      });
      document.getElementById('cookie-decline').addEventListener('click', function() {
        localStorage.setItem('cookie_consent', 'declined');
        banner.classList.add('hidden');
      });
    })();
  </script>
</body>
</html>
